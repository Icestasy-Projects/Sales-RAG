{
  "manifest_version": 3,
  "name": "Chess Coach - Position Analyzer",
  "version": "1.0.0",
  "description": "Analyze chess.com positions: see best moves, threats, and learn from every game.",
  "permissions": ["storage", "offscreen"],
  "host_permissions": ["https://www.chess.com/*"],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.chess.com/*"],
      "js": ["chess-engine.js", "board-reader.js", "content.js"],
      "css": ["overlay.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "web_accessible_resources": [
    {
      "resources": ["icons/*"],
      "matches": ["https://www.chess.com/*"]
    }
  ]
}
